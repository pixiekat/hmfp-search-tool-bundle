{
    "name": "pixiekat/hmfp-search-tool-bundle",
    "description": "A symfony bundle that provides the basic application functionality for the HMFP search tool.",
    "type": "symfony-bundle",
    "license": "proprietary",
    "keywords": [
        "hmfp",
        "bidmc",
        "search",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "pixiekat",
            "email": "katherinebloom@tuta.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "api-platform/core": "^4.3",
        "defuse/php-encryption": "^2.1",
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "nowo-tech/doctrine-encrypt-bundle": "^2.3",
        "pixiekat/symfony-common-helpers": "^2.0",
        "symfony/console": "^8.1",
        "symfony/framework-bundle": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "Pixiekat\\HMFPSearchToolBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pixiekat\\HMFPSearchToolBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "bump-after-update": true,
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    }
}

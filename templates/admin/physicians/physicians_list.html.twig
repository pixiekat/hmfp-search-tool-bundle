{% extends '@HMFPSearchTool/admin/layout.html.twig' %}
{% block admin_page_title %}Physicians{% endblock %}

{% block content %}
  <div class="actions">
    <a href="{{ path('hmfp_search_tool_admin_physicians_add') }}" class="button">Add Physician</a>
  </div>

  <div class="table-wrap">
    <table>
      <caption>{{ total }} physician{{ total == 1 ? '' : 's' }} · page {{ page }} of {{ pages }}</caption>
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Department(s)</th>
          <th scope="col">Facility(s)</th>
          <th scope="col"><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        {% for physician in physicians|default([]) %}
          <tr>
            <th scope="row">
              {{ physician.getLegalName }}
              {% if physician.getCredentials is not empty %}
                ({{ physician.getCredentials }})
              {% endif %}
            </th>
            <td>
              {% for department in physician.getDepartments %}
                {{ department.getName }}{% if not loop.last %}, {% endif %}
              {% endfor %}
            </td>
            <td>
              {% for facility in physician.getFacilities %}
                {{ facility.getName }}{% if not loop.last %}, {% endif %}
              {% endfor %}
            </td>
            <td>
              <a href="{{ path('hmfp_search_tool_admin_physician_edit_history', {'id': physician.id}) }}" class="button button--secondary">
                View Edit History<span class="visually-hidden"> for {{ physician.getLegalName }}</span>
              </a>
              {# Accessible names say WHICH department — a column of identical "Edit"
                 and "Delete" controls is unusable in a screen reader's list. #}
              <a href="{{ path('hmfp_search_tool_admin_physician_edit', {'id': physician.id}) }}" class="button button--secondary">
                Edit<span class="visually-hidden"> {{ physician.getLegalName }}</span>
              </a>
              <form method="post" action="{{ path('hmfp_search_tool_admin_physician_delete', {'id': physician.id}) }}" class="inline"
                    onsubmit="return confirm('Delete {{ physician.getLegalName }}? This cannot be undone.');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-physician-' ~ physician.id) }}">
                <button type="submit" class="button--danger">
                  Delete<span class="visually-hidden"> {{ physician.getLegalName }}</span>
                </button>
              </form>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="3">No physicians found.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {% if pages > 1 %}
    <nav class="pagination" aria-label="Physicians pages">
      {% if page > 1 %}
        <a href="{{ path('hmfp_search_tool_admin_physicians_list', {page: page - 1}) }}" rel="prev">← Previous</a>
      {% else %}
        <span class="muted" aria-hidden="true">← Previous</span>
      {% endif %}
      <span>Page {{ page }} of {{ pages }}</span>
      {% if page < pages %}
        <a href="{{ path('hmfp_search_tool_admin_physicians_list', {page: page + 1}) }}" rel="next">Next →</a>
      {% else %}
        <span class="muted" aria-hidden="true">Next →</span>
      {% endif %}
    </nav>
  {% endif %}

{% endblock %}

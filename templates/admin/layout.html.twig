{#
  HMFP Search Tool's admin layout.
#}
{% extends '@PixiekatSymfonyHelpers/admin/cp_layout.html.twig' %}

{% set admin_nav_sections = helpers_admin_nav()|merge([
  {
    label: 'Users & Access',
    links: [
      {route: 'hmfp_search_tool_admin_users_list', label: 'Users', also: ['hmfp_search_tool_admin_user_edit']},
      {route: 'hmfp_search_tool_admin_user_add', label: 'Add User'},
    ],
  },
  {
    'label': 'Search Statistics',
    'links': [
      {'route': 'hmfp_search_tool_statistics', 'label': 'Search Statistics', 'also': []}
    ]
  },
  {
    label: 'HMFP Search Tool',
    links: [
      {route: 'hmfp_search_tool_admin_departments_list', label: 'Departments', also: ['hmfp_search_tool_admin_department_add']},
      {route: 'hmfp_search_tool_admin_departments_add', label: 'Add Department'},
      {route: 'hmfp_search_tool_admin_physicians_list', label: 'Physicians', also: ['hmfp_search_tool_admin_physician_add']},
      {route: 'hmfp_search_tool_admin_physicians_add', label: 'Add Physician'},
      {route: 'hmfp_search_tool_admin_facilities_list', label: 'Facilities', also: []},
    ],
  },
  {
    "label": "Physician Edits",
    "links": [
      {"route": "hmfp_search_tool_admin_physician_edits", "label": "Physician Edit Queue", also: ["hmfp_search_tool_admin_physician_edit_history_all"]},
      {"route": "hmfp_search_tool_admin_physician_edit_history_all", "label": "All Edit History", also: []}
    ]
  }
]) %}

{# If current user does not have the ROLE_ADMIN role, then filter out Content, Taxonomy, Users & Access, Community, and System. #}
{% if app.user %}
  {% if is_granted(constant('Pixiekat\\HMFPSearchToolBundle\\Interfaces\\Security\\Voter\\AdminVoterInterface::PERMISSION_CAN_ACCESS_ADMIN')) == false %}
    {% for section in admin_nav_sections %}
      {% if section.label in ['Content', 'Taxonomy', 'Users & Access', 'Community', 'System', 'HMFP Search Tool'] %}
        {% set admin_nav_sections = admin_nav_sections|filter(s => s != section) %}
      {% endif %}
    {% endfor %}
  {% endif %}
  {% if is_granted(constant('Pixiekat\\HMFPSearchToolBundle\\Interfaces\\Security\\Voter\\AdminVoterInterface::PERMISSION_CAN_ACCESS_REPORTS')) == false %}
    {% for section in admin_nav_sections %}
      {% if section.label == 'Search Statistics' %}
        {% set admin_nav_sections = admin_nav_sections|filter(s => s != section) %}
      {% endif %}
    {% endfor %}
  {% endif %}
  {% if is_granted(constant('Pixiekat\\HMFPSearchToolBundle\\Interfaces\\Security\\Voter\\AdminVoterInterface::PERMISSION_CAN_MANAGE_USERS')) == false %}
    {% for section in admin_nav_sections %}
      {% if section.label == 'Users & Access' %}
        {% set admin_nav_sections = admin_nav_sections|filter(s => s != section) %}
      {% endif %}
    {% endfor %}
  {% endif %}
  {% if is_granted(constant('Pixiekat\\HMFPSearchToolBundle\\Interfaces\\Security\\Voter\\AdminVoterInterface::PERMISSION_CAN_APPROVE_EDITS')) == false %}
    {% for section in admin_nav_sections %}
      {% if section.label == 'Physician Edits' %}
        {% set admin_nav_sections = admin_nav_sections|filter(s => s != section) %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}

{% block admin_brand %}HMFP Search Tool{% endblock %}

{% block admin_header_links %}
  {% if app.user %}
    <span>Logged in as <strong>{{ app.user.displayName }}</strong></span>
  {% endif %}
  <a href="{{ path('pixiekat_symfony_helpers_logout') }}">Log out</a>
{% endblock %}

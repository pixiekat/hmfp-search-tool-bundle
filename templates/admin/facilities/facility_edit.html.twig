{% extends '@HMFPSearchTool/admin/layout.html.twig' %}
{% block admin_page_title %}Edit {{ facility.name }}{% endblock %}

{% block content %}
  <div class="actions">
    <a href="{{ path('hmfp_search_tool_admin_facilities_list') }}" class="button button--secondary">&larr; Back to Facilities</a>
  </div>

  <div data-turbo="false">
    {{ form_start(form) }}
      {{ form_widget(form) }}
      <button type="submit">Save Changes</button>
    {{ form_end(form) }}
  </div>
{% endblock %}

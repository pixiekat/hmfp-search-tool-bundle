{% extends '@HMFPSearchTool/search/layout.html.twig' %}

{% block content %}
  {% if error %}
    <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
  {% endif %}

  <div class="container">
    <div class="row">
      <div class="col-12">
        <h1>{{ 'Login to the HMFP Search Tool App'|trans }}</h1>
        <p>{{ 'Access to this site is granted using your BIDMC authentication credentials. To begin the process, click on the "Login with BIDMC" button below. You will be taken to the BIDMC Microsoft Outlook 365 authentication platform.'|trans }}</p>
        <p>{{ 'If you have any problems accessing this system, please contact <a href="mailto:help@alicantobidmc.org">help@alicantobidmc.org</a> for further assistance.'|trans|raw }}</p>
      </div>
    </div>
    <div class="row">
      <div class="col-12 my-3 pb-2">
        <div class="d-flex flex-column">
          <div class="d-block">
            <a class="button button--secondary" href="{{ path('saml_login') }}">{{ 'buttons.login_saml'|trans }}</a>
          </div>
          <p class="text-muted">{{ 'login_saml_help'|trans }}</p>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col">
        <h1>Login</h1>
        <p>Login to your account</p>

        <div class="login-form" data-turbo="false">
            {{ form(form) }}
        </div>
      </div>
    </div>
  </div>
{% endblock %}
